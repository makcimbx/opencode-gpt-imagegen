{
  "name": "@makcimbx/opencode-gpt-imagegen",
  "version": "0.1.10",
  "description": "OpenCode plugin for GPT Image 2 generation through Codex OAuth or OmniRoute fallback, with reference images and safe PNG output.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prebuild": "rm -rf dist",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "test": "bun test tests/unit",
    "test:e2e_subscription": "OPENCODE_MODEL=openai/gpt-5.6-sol bun test tests/e2e/subscription.test.ts",
    "test:e2e_omniroute": "GPT_IMAGEGEN_AUTH_PROVIDER=omniroute bun test tests/e2e/omniroute.test.ts",
    "prepublishOnly": "bun run build",
    "release:patch": "bun scripts/prepare-release.ts patch",
    "release:minor": "bun scripts/prepare-release.ts minor",
    "release:major": "bun scripts/prepare-release.ts major"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "openai",
    "gpt-image-2",
    "gpt-image",
    "image-generation",
    "image-editing",
    "text-to-image",
    "chatgpt",
    "chatgpt-images",
    "chatgpt-oauth",
    "codex",
    "omniroute",
    "plugin"
  ],
  "author": "Yuji Hatakeyama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makcimbx/opencode-gpt-imagegen.git"
  },
  "homepage": "https://github.com/makcimbx/opencode-gpt-imagegen#readme",
  "bugs": {
    "url": "https://github.com/makcimbx/opencode-gpt-imagegen/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@opencode-ai/plugin": "^1.14.41",
    "@tsconfig/node22": "^22.0.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.8",
    "file-type": "^22.0.1",
    "xdg-basedir": "^5.1.0"
  }
}
